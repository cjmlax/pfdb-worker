{
  "name": "pfdb-worker",
  "version": "1.1.0",
  "private": true,
  "description": "Submission/triage worker for pfdatabase.com — accepts community submissions (Chroma/Glass combos, more later), holds them for review, and pushes approved ones into Teable.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "review": "tsx src/cli/review.ts",
    "migrate-frog-ids": "tsx src/cli/migrateFrogIds.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3"
  }
}
