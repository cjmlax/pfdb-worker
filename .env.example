# Worker settings. Deployed, these go in pfdb-infra's stacks/pfdb-app/worker.env
# (identical on both nodes apart from <node ip>, that node's WireGuard address).

# ── Server ──────────────────────────────────────────────────────────────────
# HAProxy sends pfdatabase.com/api/* to port 8090 on the active node.
PORT=8090
HOST=0.0.0.0
# Public origin of the site. Used for the account-linking callback URL.
SITE_URL=https://pfdatabase.com
# Origin allowed to call the API. Comma-separated for several.
ALLOWED_ORIGIN=https://pfdatabase.com

# ── Postgres ─────────────────────────────────────────────────────────────────
# Through the node's HAProxy (port 5000), which always reaches the primary. The
# worker creates its tables on first start.
DATABASE_URL=postgresql://pfdb_submissions:<worker db password>@<node ip>:5000/pfdb_submissions

# ── Screenshots (Garage) ─────────────────────────────────────────────────────
# Over the mesh, not through s3.pfdatabase.com. The key is Garage's worker-key
# (garage key info worker-key --show-secret).
S3_ENDPOINT=http://<node ip>:3900
S3_REGION=garage
S3_BUCKET=pfdb-worker
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Sign-in (Zitadel) ────────────────────────────────────────────────────────
# Public values with working defaults in config.ts. The worker verifies the SPA's
# id_token and reads the user's roles from the roles claim (an object keyed by
# role name).
USER_OIDC_ISSUER=https://auth.pfdatabase.com
USER_OIDC_CLIENT_ID=394712072014790658
USER_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
USER_OIDC_ADMIN_ROLE=admins
USER_OIDC_MOD_ROLE=mods

# ── Account linking (Zitadel API) ────────────────────────────────────────────
# Zitadel inside the compose network. Every call sends Host: ZITADEL_PUBLIC_HOST,
# or Zitadel answers "Instance not found".
ZITADEL_API_URL=http://zitadel:8080
ZITADEL_PUBLIC_HOST=auth.pfdatabase.com
# Personal access token of the pfdb-worker machine user (PFDB org, Org User Manager).
ZITADEL_SERVICE_TOKEN=
# Identity provider ids, from each provider's page in the Zitadel console.
ZITADEL_IDP_DISCORD=
ZITADEL_IDP_TWITCH=
ZITADEL_IDP_GOOGLE=

# ── Abuse tracking ───────────────────────────────────────────────────────────
# Salt for hashing submitter IPs. Falls back to COOKIE_SECRET if unset, so
# carrying COOKIE_SECRET over keeps the same hashes. Generate: `openssl rand -hex 32`
IP_HASH_SECRET=

# ── Teable (privileged — stays server-side, never shipped to the browser) ────
TEABLE_BASE_URL=https://teable.pfdatabase.com
TEABLE_TOKEN=
# Individual table IDs are resolved by name at runtime (and cached), so they no
# longer need to be configured — only the base ID (defaulted in config.ts).
TEABLE_BASE_ID=bseylZk8mJzj9xeoAHy

# ── Changelog / Version Poller ───────────────────────────────────────────────
# New iOS/Android versions (scraped from Apptopia's version history) are written
# to the Teable "Changelog" table. Cron schedule (default: daily at 6 AM).
CHANGELOG_POLL_CRON=0 6 * * *

# ── Weekly Sets Poller ───────────────────────────────────────────────────────
# Cron schedule for polling https://nimblebit.com/sets/txt (default: Mondays at 2:02 PM ET).
WEEKLY_SETS_POLL_CRON=2 14 * * 1

# ── Frog Stats Cache ─────────────────────────────────────────────────────────
# The home page's frog count and highest value (/api/stats/frogs) and the Frog of
# the Day (/api/stats/daily-frog) are computed from Teable and served from memory.
# Also refreshed at startup, and after approved stats submissions that affect
# them. The daily run also precomputes tomorrow's frog (default: daily at 5 AM).
FROG_STATS_REFRESH_CRON=0 5 * * *

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=5242880

# ── Notifications ────────────────────────────────────────────────────────────
# Webhook URL(s) to notify on submission events. Comma-separated for multiple.
# Payload is ntfy-compatible JSON (title, message, priority, tags, click) plus
# structured `event` and `submission` fields for generic consumers.
#
# ntfy example (no auth):    WEBHOOK_URL=https://ntfy.sh/your-topic
# ntfy example (token auth): WEBHOOK_URL=https://tk_xxxxxxxxxxxx@ntfy.sh/your-topic
# ntfy example (user/pass):  WEBHOOK_URL=https://user:pass@ntfy.sh/your-topic
# Discord example:           WEBHOOK_URL=https://discord.com/api/webhooks/...
WEBHOOK_URL=
# Base site URL — notifications append /admin/submissions for the "click" link.
# Defaults to SITE_URL.
ADMIN_URL=https://pfdatabase.com
# Set any to false to suppress that event type (all default to true).
WEBHOOK_ON_SUBMIT=true
WEBHOOK_ON_APPROVE=true
WEBHOOK_ON_REJECT=true
# Background poller failures (changelog versions, weekly sets).
WEBHOOK_ON_POLLER_FAIL=true
